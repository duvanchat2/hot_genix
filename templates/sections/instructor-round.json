{
  "nombre": "instructor-round",
  "descripcion": "Instructor sobre fondo claro: foto circular a la izquierda y a la derecha el titular y la bio (HTML con varios párrafos en copy.instructor.bio_html).",
  "requiere": [
    "copy.instructor.headline",
    "copy.instructor.bio_html"
  ],
  "nodos": [
    {
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "row",
        "padding": {
          "unit": "px",
          "top": "96",
          "right": "20",
          "bottom": "96",
          "left": "20",
          "isLinked": false
        },
        "padding_mobile": {
          "unit": "px",
          "top": "64",
          "right": "16",
          "bottom": "64",
          "left": "16",
          "isLinked": false
        },
        "background_background": "classic",
        "background_color": {
          "_color": "surface_light"
        },
        "flex_wrap": "wrap",
        "flex_align_items": "center",
        "flex_justify_content": "center",
        "flex_gap": {
          "unit": "px",
          "size": 48,
          "column": "48",
          "row": "28",
          "isLinked": false
        },
        "boxed_width": {
          "unit": "px",
          "size": 960
        }
      },
      "elements": [
        {
          "_if": "curso.instructor.foto",
          "elType": "container",
          "isInner": true,
          "settings": {
            "content_width": "full",
            "width": {
              "unit": "px",
              "size": 260
            },
            "width_mobile": {
              "unit": "px",
              "size": 200
            },
            "flex_direction": "column"
          },
          "elements": [
            {
              "elType": "widget",
              "widgetType": "image",
              "settings": {
                "image": {
                  "url": "{{curso.instructor.foto}}",
                  "id": "",
                  "source": "url",
                  "alt": "{{curso.instructor.nombre}}"
                },
                "image_size": "full",
                "align": "center",
                "width": {
                  "unit": "px",
                  "size": 260
                },
                "width_mobile": {
                  "unit": "px",
                  "size": 200
                },
                "height": {
                  "unit": "px",
                  "size": 260
                },
                "height_mobile": {
                  "unit": "px",
                  "size": 200
                },
                "object-fit": "cover",
                "image_border_radius": {
                  "unit": "%",
                  "top": "50",
                  "right": "50",
                  "bottom": "50",
                  "left": "50",
                  "isLinked": true
                }
              },
              "elements": []
            }
          ]
        },
        {
          "elType": "container",
          "isInner": true,
          "settings": {
            "content_width": "full",
            "width": {
              "unit": "%",
              "size": 58
            },
            "width_tablet": {
              "unit": "%",
              "size": 100
            },
            "width_mobile": {
              "unit": "%",
              "size": 100
            },
            "flex_grow": 1,
            "flex_direction": "column",
            "flex_gap": {
              "unit": "px",
              "size": 16,
              "column": "16",
              "row": "16",
              "isLinked": true
            }
          },
          "elements": [
            {
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "{{copy.instructor.headline}}",
                "header_size": "h2",
                "title_color": {
                  "_color": "text"
                },
                "typography_typography": "custom",
                "typography_font_family": {
                  "_font": "heading"
                },
                "typography_font_size": {
                  "unit": "px",
                  "size": 40
                },
                "typography_font_size_mobile": {
                  "unit": "px",
                  "size": 27
                },
                "typography_font_weight": "800",
                "typography_line_height": {
                  "unit": "em",
                  "size": 1.15
                },
                "typography_letter_spacing": {
                  "unit": "px",
                  "size": -0.6
                }
              },
              "elements": []
            },
            {
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "{{copy.instructor.bio_html}}",
                "text_color": {
                  "_color": "text_muted"
                },
                "typography_typography": "custom",
                "typography_font_family": {
                  "_font": "body"
                },
                "typography_font_size": {
                  "unit": "px",
                  "size": 18
                },
                "typography_font_size_mobile": {
                  "unit": "px",
                  "size": 16
                },
                "typography_line_height": {
                  "unit": "em",
                  "size": 1.65
                },
                "paragraph_spacing": {
                  "unit": "px",
                  "size": 16
                }
              },
              "elements": []
            }
          ]
        }
      ]
    }
  ]
}
