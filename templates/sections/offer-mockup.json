{
  "nombre": "offer-mockup",
  "descripcion": "Oferta con mockup del curso: imagen + precio a la izquierda, lista de beneficios a la derecha. Distinta de 'offer' (que lista los módulos) — esta vende el resultado general.",
  "requiere": ["copy.offer_mockup.headline", "copy.offer_mockup.beneficios", "curso.precio"],
  "nodos": [
    {
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "center",
        "flex_gap": { "unit": "px", "size": 46, "column": "46", "row": "46", "isLinked": true },
        "padding": { "unit": "px", "top": "{{marca.escala.seccionPaddingY}}", "right": "20", "bottom": "{{marca.escala.seccionPaddingY}}", "left": "20", "isLinked": false },
        "background_background": "classic",
        "background_color": { "_color": "surface_muted" }
      },
      "elements": [
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.offer_mockup.headline}}",
            "header_size": "h2",
            "align": "center",
            "title_color": { "_color": "text" },
            "typography_typography": "custom",
            "typography_font_size": { "unit": "px", "size": "{{marca.escala.h2}}" },
            "typography_font_size_mobile": { "unit": "px", "size": 27 },
            "typography_font_weight": "800",
            "typography_line_height": { "unit": "em", "size": 1.2 },
            "_element_custom_width": { "unit": "%", "size": 70 }
          },
          "elements": []
        },
        {
          "elType": "container",
          "isInner": true,
          "settings": {
            "content_width": "full",
            "flex_direction": "row",
            "flex_align_items": "center",
            "flex_wrap": "wrap",
            "flex_gap": { "unit": "px", "size": 56, "column": "56", "row": "40", "isLinked": false }
          },
          "elements": [
            {
              "elType": "container",
              "isInner": true,
              "settings": {
                "content_width": "full",
                "width": { "unit": "%", "size": 42 },
                "flex_grow": 1,
                "flex_direction": "column",
                "flex_align_items": "center",
                "flex_gap": { "unit": "px", "size": 24, "column": "24", "row": "24", "isLinked": true }
              },
              "elements": [
                {
                  "elType": "widget",
                  "widgetType": "image",
                  "settings": {
                    "_if": "assets.mockup-curso",
                    "image": { "url": "{{assets.mockup-curso}}", "source": "url", "alt": "{{curso.nombre}}" },
                    "image_size": "full",
                    "width": { "unit": "%", "size": 82 }
                  },
                  "elements": []
                },
                {
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "_if": "d.precio_ancla",
                    "title": "{{d.simbolo}}{{d.valor_total | money}}",
                    "header_size": "div",
                    "align": "center",
                    "title_color": { "_color": "text_muted" },
                    "typography_typography": "custom",
                    "typography_font_size": { "unit": "px", "size": 17 },
                    "typography_font_weight": "600",
                    "typography_text_decoration": "line-through"
                  },
                  "elements": []
                },
                {
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "{{d.simbolo}}{{d.precio | money}} {{d.moneda}}",
                    "header_size": "div",
                    "align": "center",
                    "title_color": { "_color": "text" },
                    "typography_typography": "custom",
                    "typography_font_size": { "unit": "px", "size": 48 },
                    "typography_font_weight": "800",
                    "typography_line_height": { "unit": "em", "size": 1 }
                  },
                  "elements": []
                },
                {
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "_if": "curso.pago.nota",
                    "title": "{{curso.pago.nota}}",
                    "header_size": "div",
                    "align": "center",
                    "title_color": { "_color": "text_muted" },
                    "typography_typography": "custom",
                    "typography_font_size": { "unit": "px", "size": 14 }
                  },
                  "elements": []
                },
                {
                  "elType": "widget",
                  "widgetType": "button",
                  "settings": {
                    "text": "{{copy.offer_mockup.cta}}",
                    "link": { "url": "{{curso.checkout_url}}", "is_external": "on", "nofollow": "", "custom_attributes": "" },
                    "align": "center",
                    "size": "lg",
                    "background_background": "gradient",
                    "background_color": { "_color": "secondary" },
                    "background_color_b": { "_color": "primary" },
                    "background_gradient_angle": { "unit": "deg", "size": 135 },
                    "button_text_color": "#FFFFFF",
                    "border_radius": { "unit": "px", "top": "{{marca.escala.radioBoton}}", "right": "{{marca.escala.radioBoton}}", "bottom": "{{marca.escala.radioBoton}}", "left": "{{marca.escala.radioBoton}}", "isLinked": true },
                    "text_padding": { "unit": "px", "top": "22", "right": "46", "bottom": "22", "left": "46", "isLinked": false },
                    "typography_typography": "custom",
                    "typography_font_size": { "unit": "px", "size": 19 },
                    "typography_font_weight": "800"
                  },
                  "elements": []
                }
              ]
            },
            {
              "elType": "container",
              "isInner": true,
              "settings": {
                "content_width": "full",
                "width": { "unit": "%", "size": 42 },
                "flex_grow": 1,
                "flex_direction": "column",
                "flex_gap": { "unit": "px", "size": 15, "column": "15", "row": "15", "isLinked": true }
              },
              "elements": [
                {
                  "elType": "widget",
                  "widgetType": "icon-list",
                  "settings": {
                    "icon_list": {
                      "_map": "copy.offer_mockup.beneficios",
                      "_as": "b",
                      "_template": {
                        "text": "{{b}}",
                        "selected_icon": { "value": "fas fa-check-circle", "library": "fa-solid" }
                      }
                    },
                    "space_between": { "unit": "px", "size": 15 },
                    "icon_color": { "_color": "primary" },
                    "icon_size": { "unit": "px", "size": 20 },
                    "text_color": { "_color": "text" },
                    "typography_typography": "custom",
                    "typography_font_size": { "unit": "px", "size": 16 },
                    "typography_line_height": { "unit": "em", "size": 1.5 }
                  },
                  "elements": []
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
