{
  "nombre": "bonus-image",
  "descripcion": "Variante de 'bonus' con una imagen ilustrando cada bonus (badge + imagen + texto), apilados verticalmente, cerrando con un CTA ancho. No muestra el valor en dólares por bonus (para eso usa 'bonus.json' o el stack de precio) — pensada para bonus con y sin precio individual mezclados.",
  "requiere": ["copy.bonus.headline", "curso.bonus"],
  "nodos": [
    {
      "_if": "curso.bonus",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "center",
        "flex_gap": { "unit": "px", "size": 14, "column": "14", "row": "14", "isLinked": true },
        "padding": { "unit": "px", "top": "{{marca.escala.seccionPaddingY}}", "right": "20", "bottom": "{{marca.escala.seccionPaddingY}}", "left": "20", "isLinked": false },
        "background_background": "classic",
        "background_color": { "_color": "surface_dark" }
      },
      "elements": [
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.bonus.headline}}",
            "header_size": "h2",
            "align": "center",
            "title_color": { "_color": "secondary" },
            "typography_typography": "custom",
            "typography_font_size": { "unit": "px", "size": "{{marca.escala.h2}}" },
            "typography_font_size_mobile": { "unit": "px", "size": 27 },
            "typography_font_weight": "800",
            "typography_line_height": { "unit": "em", "size": 1.2 },
            "_element_custom_width": { "unit": "%", "size": 78 }
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "_if": "copy.bonus.intro",
            "editor": "<p style=\"text-align:center\">{{copy.bonus.intro}}</p>",
            "text_color": "#B7ACD6",
            "typography_typography": "custom",
            "typography_font_size": { "unit": "px", "size": 18 },
            "typography_line_height": { "unit": "em", "size": 1.6 },
            "_element_custom_width": { "unit": "%", "size": 66 }
          },
          "elements": []
        },
        {
          "elType": "container",
          "isInner": true,
          "settings": {
            "content_width": "full",
            "width": { "unit": "%", "size": 66 },
            "flex_direction": "column",
            "flex_gap": { "unit": "px", "size": 40, "column": "40", "row": "40", "isLinked": true },
            "margin": { "unit": "px", "top": "26", "right": "0", "bottom": "0", "left": "0", "isLinked": false }
          },
          "elements": [
            {
              "_repeat": "curso.bonus",
              "_as": "b",
              "elType": "container",
              "isInner": true,
              "settings": {
                "content_width": "full",
                "flex_direction": "column",
                "flex_align_items": "center",
                "flex_gap": { "unit": "px", "size": 14, "column": "14", "row": "14", "isLinked": true }
              },
              "elements": [
                {
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "BONUS {{_n}}",
                    "header_size": "div",
                    "align": "center",
                    "title_color": { "_color": "secondary" },
                    "typography_typography": "custom",
                    "typography_font_size": { "unit": "px", "size": 14 },
                    "typography_font_weight": "800",
                    "typography_letter_spacing": { "unit": "px", "size": 1.6 },
                    "typography_text_transform": "uppercase"
                  },
                  "elements": []
                },
                {
                  "elType": "widget",
                  "widgetType": "image",
                  "settings": {
                    "_if": "b.imagen",
                    "image": { "url": "{{b.imagen}}", "source": "url", "alt": "{{b.nombre}}" },
                    "image_size": "full",
                    "border_radius": { "unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true }
                  },
                  "elements": []
                },
                {
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "{{b.nombre}}",
                    "header_size": "h3",
                    "align": "center",
                    "title_color": { "_color": "text_on_dark" },
                    "typography_typography": "custom",
                    "typography_font_size": { "unit": "px", "size": 20 },
                    "typography_font_weight": "700"
                  },
                  "elements": []
                },
                {
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "_if": "b.descripcion",
                    "editor": "<p style=\"text-align:center\">{{b.descripcion}}</p>",
                    "text_color": "#B7ACD6",
                    "typography_typography": "custom",
                    "typography_font_size": { "unit": "px", "size": 15 },
                    "typography_line_height": { "unit": "em", "size": 1.55 }
                  },
                  "elements": []
                }
              ]
            }
          ]
        },
        {
          "elType": "widget",
          "widgetType": "button",
          "settings": {
            "_if": "copy.bonus.cta",
            "text": "{{copy.bonus.cta}}",
            "link": { "url": "{{curso.checkout_url}}", "is_external": "on", "nofollow": "", "custom_attributes": "" },
            "align": "justify",
            "size": "lg",
            "background_background": "gradient",
            "background_color": { "_color": "secondary" },
            "background_color_b": { "_color": "primary" },
            "background_gradient_angle": { "unit": "deg", "size": 135 },
            "button_text_color": "#FFFFFF",
            "border_radius": { "unit": "px", "top": "{{marca.escala.radioBoton}}", "right": "{{marca.escala.radioBoton}}", "bottom": "{{marca.escala.radioBoton}}", "left": "{{marca.escala.radioBoton}}", "isLinked": true },
            "text_padding": { "unit": "px", "top": "22", "right": "40", "bottom": "22", "left": "40", "isLinked": false },
            "typography_typography": "custom",
            "typography_font_size": { "unit": "px", "size": 19 },
            "typography_font_weight": "800",
            "_element_custom_width": { "unit": "%", "size": 66 }
          },
          "elements": []
        }
      ]
    }
  ]
}
