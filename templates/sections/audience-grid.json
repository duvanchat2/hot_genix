{
  "nombre": "audience-grid",
  "descripcion": "Para quién es: titular centrado, grilla 2×2 de tarjetas con check y una píldora oscura de remate (\"No necesitas saber…\").",
  "requiere": [
    "copy.audience.headline",
    "copy.audience.bullets"
  ],
  "nodos": [
    {
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "column",
        "padding": {
          "unit": "px",
          "top": "96",
          "right": "20",
          "bottom": "96",
          "left": "20",
          "isLinked": false
        },
        "padding_mobile": {
          "unit": "px",
          "top": "64",
          "right": "16",
          "bottom": "64",
          "left": "16",
          "isLinked": false
        },
        "background_background": "classic",
        "background_color": {
          "_color": "surface_light"
        },
        "flex_align_items": "center",
        "flex_gap": {
          "unit": "px",
          "size": 40,
          "column": "40",
          "row": "32",
          "isLinked": false
        },
        "boxed_width": {
          "unit": "px",
          "size": 1000
        }
      },
      "elements": [
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.audience.headline}}",
            "header_size": "h2",
            "align": "center",
            "title_color": {
              "_color": "text"
            },
            "typography_typography": "custom",
            "typography_font_family": {
              "_font": "heading"
            },
            "typography_font_size": {
              "unit": "px",
              "size": 40
            },
            "typography_font_size_mobile": {
              "unit": "px",
              "size": 27
            },
            "typography_font_weight": "800",
            "typography_line_height": {
              "unit": "em",
              "size": 1.15
            },
            "typography_letter_spacing": {
              "unit": "px",
              "size": -0.6
            }
          },
          "elements": []
        },
        {
          "elType": "container",
          "isInner": true,
          "settings": {
            "content_width": "full",
            "flex_direction": "row",
            "flex_wrap": "wrap",
            "flex_gap": {
              "unit": "px",
              "size": 16,
              "column": "16",
              "row": "16",
              "isLinked": true
            }
          },
          "elements": [
            {
              "_repeat": "copy.audience.bullets",
              "_as": "b",
              "elType": "container",
              "isInner": true,
              "settings": {
                "content_width": "full",
                "width": {
                  "unit": "%",
                  "size": 48
                },
                "width_mobile": {
                  "unit": "%",
                  "size": 100
                },
                "flex_grow": 1,
                "padding": {
                  "unit": "px",
                  "top": "24",
                  "right": "24",
                  "bottom": "24",
                  "left": "24",
                  "isLinked": false
                },
                "background_background": "classic",
                "background_color": {
                  "_color": "surface_muted"
                },
                "border_radius": {
                  "unit": "px",
                  "top": "14",
                  "right": "14",
                  "bottom": "14",
                  "left": "14",
                  "isLinked": true
                }
              },
              "elements": [
                {
                  "elType": "widget",
                  "widgetType": "icon-box",
                  "settings": {
                    "selected_icon": {
                      "value": "fas fa-check",
                      "library": "fa-solid"
                    },
                    "view": "stacked",
                    "shape": "circle",
                    "position": "left",
                    "content_vertical_alignment": "top",
                    "title_text": "{{b}}",
                    "description_text": "",
                    "title_size": "div",
                    "primary_color": {
                      "_color": "primary"
                    },
                    "secondary_color": "#FFFFFF",
                    "icon_size": {
                      "unit": "px",
                      "size": 14
                    },
                    "icon_padding": {
                      "unit": "px",
                      "size": 9
                    },
                    "icon_space": {
                      "unit": "px",
                      "size": 16
                    },
                    "title_color": {
                      "_color": "text"
                    },
                    "title_typography_typography": "custom",
                    "title_typography_font_family": {
                      "_font": "body"
                    },
                    "title_typography_font_size": {
                      "unit": "px",
                      "size": 17
                    },
                    "title_typography_font_weight": "500",
                    "title_typography_line_height": {
                      "unit": "em",
                      "size": 1.55
                    }
                  },
                  "elements": []
                }
              ]
            }
          ]
        },
        {
          "_if": "copy.audience.cierre",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "<span style=\"color:{{marca.colores.accent.hex}}\">⚡</span>&nbsp; {{copy.audience.cierre}}",
            "header_size": "div",
            "align": "center",
            "title_color": {
              "_color": "text_on_dark"
            },
            "typography_typography": "custom",
            "typography_font_family": {
              "_font": "body"
            },
            "typography_font_size": {
              "unit": "px",
              "size": 16
            },
            "typography_font_weight": "700",
            "_element_width": "auto",
            "_padding": {
              "unit": "px",
              "top": "14",
              "right": "24",
              "bottom": "14",
              "left": "24",
              "isLinked": false
            },
            "_background_background": "classic",
            "_background_color": {
              "_color": "surface_dark"
            },
            "_border_radius": {
              "unit": "px",
              "top": "999",
              "right": "999",
              "bottom": "999",
              "left": "999",
              "isLinked": true
            }
          },
          "elements": []
        }
      ]
    }
  ]
}
