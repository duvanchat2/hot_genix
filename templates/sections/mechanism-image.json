{
  "nombre": "mechanism-image",
  "descripcion": "Variante de 'mechanism' con una imagen ilustrando cada paso, apiladas verticalmente, en vez de las 3 tarjetas numeradas en grilla.",
  "requiere": ["copy.mechanism.headline", "copy.mechanism.pasos"],
  "nodos": [
    {
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "center",
        "flex_gap": { "unit": "px", "size": 26, "column": "26", "row": "26", "isLinked": true },
        "padding": { "unit": "px", "top": "{{marca.escala.seccionPaddingY}}", "right": "20", "bottom": "{{marca.escala.seccionPaddingY}}", "left": "20", "isLinked": false },
        "background_background": "classic",
        "background_color": { "_color": "surface_dark" }
      },
      "elements": [
        {
          "_if": "curso.mecanismo.nombre",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{curso.mecanismo.nombre}}",
            "header_size": "div",
            "align": "center",
            "title_color": { "_color": "secondary" },
            "typography_typography": "custom",
            "typography_font_size": { "unit": "px", "size": 14 },
            "typography_font_weight": "700",
            "typography_letter_spacing": { "unit": "px", "size": 1.5 },
            "typography_text_transform": "uppercase"
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.mechanism.headline}}",
            "header_size": "h2",
            "align": "center",
            "title_color": { "_color": "text_on_dark" },
            "typography_typography": "custom",
            "typography_font_size": { "unit": "px", "size": "{{marca.escala.h2}}" },
            "typography_font_size_mobile": { "unit": "px", "size": 27 },
            "typography_font_weight": "800",
            "typography_line_height": { "unit": "em", "size": 1.2 },
            "_element_custom_width": { "unit": "%", "size": 76 }
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "_if": "copy.mechanism.explicacion",
            "editor": "<p style=\"text-align:center\">{{copy.mechanism.explicacion}}</p>",
            "text_color": "#B7ACD6",
            "typography_typography": "custom",
            "typography_font_size": { "unit": "px", "size": 18 },
            "typography_line_height": { "unit": "em", "size": 1.65 },
            "_element_custom_width": { "unit": "%", "size": 70 }
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "_if": "copy.mechanism.pasos_titulo",
            "title": "{{copy.mechanism.pasos_titulo}}",
            "header_size": "h3",
            "align": "center",
            "title_color": { "_color": "text_on_dark" },
            "typography_typography": "custom",
            "typography_font_size": { "unit": "px", "size": 22 },
            "typography_font_weight": "700"
          },
          "elements": []
        },
        {
          "elType": "container",
          "isInner": true,
          "settings": {
            "content_width": "full",
            "width": { "unit": "%", "size": 68 },
            "flex_direction": "column",
            "flex_gap": { "unit": "px", "size": 34, "column": "34", "row": "34", "isLinked": true }
          },
          "elements": [
            {
              "_repeat": "copy.mechanism.pasos",
              "_as": "paso",
              "elType": "container",
              "isInner": true,
              "settings": {
                "content_width": "full",
                "flex_direction": "column",
                "flex_gap": { "unit": "px", "size": 14, "column": "14", "row": "14", "isLinked": true }
              },
              "elements": [
                {
                  "elType": "widget",
                  "widgetType": "image",
                  "settings": {
                    "_if": "paso.imagen",
                    "image": { "url": "{{paso.imagen}}", "source": "url", "alt": "{{paso.titulo}}" },
                    "image_size": "full",
                    "border_radius": { "unit": "px", "top": "16", "right": "16", "bottom": "16", "left": "16", "isLinked": true }
                  },
                  "elements": []
                },
                {
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "0{{_n}}",
                    "header_size": "div",
                    "title_color": { "_color": "secondary" },
                    "typography_typography": "custom",
                    "typography_font_size": { "unit": "px", "size": 14 },
                    "typography_font_weight": "800",
                    "typography_letter_spacing": { "unit": "px", "size": 1.2 }
                  },
                  "elements": []
                },
                {
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "{{paso.titulo}}",
                    "header_size": "h3",
                    "title_color": { "_color": "text_on_dark" },
                    "typography_typography": "custom",
                    "typography_font_size": { "unit": "px", "size": 22 },
                    "typography_font_weight": "700"
                  },
                  "elements": []
                },
                {
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p>{{paso.descripcion}}</p>",
                    "text_color": "#B7ACD6",
                    "typography_typography": "custom",
                    "typography_font_size": { "unit": "px", "size": 16 },
                    "typography_line_height": { "unit": "em", "size": 1.55 }
                  },
                  "elements": []
                }
              ]
            }
          ]
        },
        {
          "elType": "widget",
          "widgetType": "button",
          "settings": {
            "_if": "copy.mechanism.cta",
            "text": "{{copy.mechanism.cta}}",
            "link": { "url": "{{curso.checkout_url}}", "is_external": "on", "nofollow": "", "custom_attributes": "" },
            "align": "center",
            "size": "lg",
            "background_color": { "_color": "primary" },
            "button_text_color": "#FFFFFF",
            "border_radius": { "unit": "px", "top": "{{marca.escala.radioBoton}}", "right": "{{marca.escala.radioBoton}}", "bottom": "{{marca.escala.radioBoton}}", "left": "{{marca.escala.radioBoton}}", "isLinked": true },
            "text_padding": { "unit": "px", "top": "20", "right": "44", "bottom": "20", "left": "44", "isLinked": false },
            "typography_typography": "custom",
            "typography_font_size": { "unit": "px", "size": 18 },
            "typography_font_weight": "700"
          },
          "elements": []
        }
      ]
    }
  ]
}
