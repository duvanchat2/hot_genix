{
  "nombre": "hero-vsl",
  "descripcion": "Hero con Video Sales Letter: titular corto encima, video 16:9, CTA debajo. El titular solo tiene que conseguir que le den al play.",
  "requiere": [
    "copy.hero.headline",
    "copy.hero.cta",
    "curso.vsl.url",
    "curso.checkout_url"
  ],
  "nodos": [
    {
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "center",
        "flex_gap": {
          "unit": "px",
          "size": 28,
          "column": "28",
          "row": "28",
          "isLinked": true
        },
        "padding": {
          "unit": "px",
          "top": "72",
          "right": "20",
          "bottom": "80",
          "left": "20",
          "isLinked": false
        },
        "background_background": "classic",
        "background_color": {
          "_color": "surface_dark"
        }
      },
      "elements": [
        {
          "_if": "copy.hero.eyebrow",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.hero.eyebrow}}",
            "header_size": "div",
            "align": "center",
            "title_color": {
              "_color": "primary"
            },
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 14
            },
            "typography_font_weight": "700",
            "typography_letter_spacing": {
              "unit": "px",
              "size": 1.5
            },
            "typography_text_transform": "uppercase"
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.hero.headline}}",
            "header_size": "h1",
            "align": "center",
            "title_color": {
              "_color": "text_on_dark"
            },
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 44
            },
            "typography_font_size_mobile": {
              "unit": "px",
              "size": 28
            },
            "typography_font_weight": "800",
            "typography_line_height": {
              "unit": "em",
              "size": 1.15
            },
            "_element_custom_width": {
              "unit": "%",
              "size": 76
            }
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "video",
          "settings": {
            "video_type": "{{curso.vsl.plataforma}}",
            "youtube_url": "{{curso.vsl.url}}",
            "vimeo_url": "{{curso.vsl.url}}",
            "aspect_ratio": "169",
            "autoplay": "",
            "mute": "",
            "controls": "yes",
            "show_image_overlay": "yes",
            "image_overlay": {
              "url": "{{curso.vsl.portada}}",
              "source": "url"
            },
            "lightbox": "",
            "_element_custom_width": {
              "unit": "%",
              "size": 78
            },
            "border_radius": {
              "unit": "px",
              "top": "16",
              "right": "16",
              "bottom": "16",
              "left": "16",
              "isLinked": true
            }
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "button",
          "settings": {
            "text": "{{copy.hero.cta}}",
            "link": {
              "url": "{{curso.checkout_url}}",
              "is_external": "on",
              "nofollow": "",
              "custom_attributes": ""
            },
            "align": "center",
            "size": "lg",
            "background_color": {
              "_color": "primary"
            },
            "button_text_color": "#FFFFFF",
            "border_radius": {
              "unit": "px",
              "top": "{{marca.escala.radioBoton}}",
              "right": "{{marca.escala.radioBoton}}",
              "bottom": "{{marca.escala.radioBoton}}",
              "left": "{{marca.escala.radioBoton}}",
              "isLinked": true
            },
            "text_padding": {
              "unit": "px",
              "top": "20",
              "right": "44",
              "bottom": "20",
              "left": "44",
              "isLinked": false
            },
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 18
            },
            "typography_font_weight": "700"
          },
          "elements": []
        },
        {
          "_if": "copy.hero.microcopy",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p style=\"text-align:center\">{{copy.hero.microcopy}}</p>",
            "text_color": {
              "_color": "text_muted"
            },
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 14
            }
          },
          "elements": []
        }
      ]
    }
  ]
}
