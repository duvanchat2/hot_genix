{
  "nombre": "hero-copy",
  "descripcion": "Hero sin video: eyebrow, titular, subtítulo, CTA y microcopy de reversión de riesgo. Fondo oscuro.",
  "requiere": [
    "copy.hero.headline",
    "copy.hero.subhead",
    "copy.hero.cta",
    "curso.checkout_url"
  ],
  "nodos": [
    {
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "center",
        "flex_gap": {
          "unit": "px",
          "size": 24,
          "column": "24",
          "row": "24",
          "isLinked": true
        },
        "padding": {
          "unit": "px",
          "top": "96",
          "right": "20",
          "bottom": "96",
          "left": "20",
          "isLinked": false
        },
        "background_background": "gradient",
        "background_color": {
          "_color": "secondary"
        },
        "background_color_b": {
          "_color": "primary"
        },
        "background_gradient_angle": {
          "unit": "deg",
          "size": 135
        }
      },
      "elements": [
        {
          "_if": "copy.hero.eyebrow",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.hero.eyebrow}}",
            "header_size": "div",
            "align": "center",
            "title_color": "#FFFFFF",
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 14
            },
            "typography_font_weight": "700",
            "typography_letter_spacing": {
              "unit": "px",
              "size": 1.5
            },
            "typography_text_transform": "uppercase"
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.hero.headline}}",
            "header_size": "h1",
            "align": "center",
            "title_color": "#FFFFFF",
            "text_shadow_text_shadow_type": "yes",
            "text_shadow_text_shadow": {
              "horizontal": 0,
              "vertical": 2,
              "blur": 18,
              "color": "rgba(11,10,40,0.55)"
            },
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": "{{marca.escala.h1}}"
            },
            "typography_font_size_tablet": {
              "unit": "px",
              "size": 40
            },
            "typography_font_size_mobile": {
              "unit": "px",
              "size": 32
            },
            "typography_font_weight": "800",
            "typography_line_height": {
              "unit": "em",
              "size": 1.12
            },
            "_element_custom_width": {
              "unit": "%",
              "size": 82
            }
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p style=\"text-align:center\">{{copy.hero.subhead}}</p>",
            "text_color": "rgba(255,255,255,0.94)",
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 20
            },
            "typography_line_height": {
              "unit": "em",
              "size": 1.55
            },
            "_element_custom_width": {
              "unit": "%",
              "size": 68
            }
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "button",
          "settings": {
            "text": "{{copy.hero.cta}}",
            "link": {
              "url": "{{curso.checkout_url}}",
              "is_external": "on",
              "nofollow": "",
              "custom_attributes": ""
            },
            "align": "center",
            "size": "lg",
            "background_color": "#FFFFFF",
            "button_text_color": {
              "_color": "primary"
            },
            "border_radius": {
              "unit": "px",
              "top": "{{marca.escala.radioBoton}}",
              "right": "{{marca.escala.radioBoton}}",
              "bottom": "{{marca.escala.radioBoton}}",
              "left": "{{marca.escala.radioBoton}}",
              "isLinked": true
            },
            "text_padding": {
              "unit": "px",
              "top": "20",
              "right": "44",
              "bottom": "20",
              "left": "44",
              "isLinked": false
            },
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 18
            },
            "typography_font_weight": "700"
          },
          "elements": []
        },
        {
          "_if": "copy.hero.microcopy",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p style=\"text-align:center\">{{copy.hero.microcopy}}</p>",
            "text_color": "rgba(255,255,255,0.72)",
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 14
            }
          },
          "elements": []
        }
      ]
    }
  ]
}
