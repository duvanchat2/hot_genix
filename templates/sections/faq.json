{
  "nombre": "faq",
  "descripcion": "Objeciones respondidas, en acordeón. Cada objeción del avatar debería aparecer aquí.",
  "requiere": [
    "copy.faq"
  ],
  "notas": "Usa el widget clásico 'accordion'. Elementor 3.24+ lo oculta por defecto en instalaciones nuevas: si no aparece, activa Ajustes → Funciones experimentales → widgets clásicos, o cambia a la variante 'faq-plain' en structure.json.",
  "nodos": [
    {
      "_if": "copy.faq",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "center",
        "flex_gap": {
          "unit": "px",
          "size": 28,
          "column": "28",
          "row": "28",
          "isLinked": true
        },
        "padding": {
          "unit": "px",
          "top": "{{marca.escala.seccionPaddingY}}",
          "right": "20",
          "bottom": "{{marca.escala.seccionPaddingY}}",
          "left": "20",
          "isLinked": false
        },
        "background_background": "classic",
        "background_color": {
          "_color": "surface_light"
        }
      },
      "elements": [
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.faq_headline}}",
            "header_size": "h2",
            "align": "center",
            "title_color": {
              "_color": "text"
            },
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": "{{marca.escala.h2}}"
            },
            "typography_font_size_mobile": {
              "unit": "px",
              "size": 27
            },
            "typography_font_weight": "800"
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "accordion",
          "settings": {
            "tabs": {
              "_as": "q",
              "_map": "copy.faq",
              "_template": {
                "tab_title": "{{q.pregunta}}",
                "tab_content": "<p>{{q.respuesta}}</p>"
              }
            },
            "selected_icon": {
              "value": "fas fa-plus",
              "library": "fa-solid"
            },
            "selected_active_icon": {
              "value": "fas fa-minus",
              "library": "fa-solid"
            },
            "title_html_tag": "h3",
            "title_color": {
              "_color": "text"
            },
            "content_color": {
              "_color": "text_muted"
            },
            "icon_color": {
              "_color": "primary"
            },
            "title_typography_typography": "custom",
            "title_typography_font_size": {
              "unit": "px",
              "size": 18
            },
            "title_typography_font_weight": "700",
            "content_typography_typography": "custom",
            "content_typography_font_size": {
              "unit": "px",
              "size": 16
            },
            "content_typography_line_height": {
              "unit": "em",
              "size": 1.6
            },
            "_element_custom_width": {
              "unit": "%",
              "size": 78
            }
          },
          "elements": []
        }
      ]
    }
  ]
}
