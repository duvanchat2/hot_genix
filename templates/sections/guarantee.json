            "title_typography_font_weight": "800",
            "description_typography_typography": "custom",
            "description_typography_font_size": {
              "unit": "px",
              "size": 17
            },
            "description_typography_line_height": {
              "unit": "em",
              "size": 1.6
            },
            "text_align": "center",
            "_element_custom_width": {
              "unit": "%",
              "size": 62
            }
          },
          "elements": []
        }
      ]
    }
  ]
