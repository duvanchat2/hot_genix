{
  "nombre": "guarantee",
  "descripcion": "Reversión de riesgo. Se omite sola si el brief no declara garantía.",
  "requiere": [
    "curso.garantia.dias"
  ],
  "nodos": [
    {
      "_if": "curso.garantia.dias",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "center",
        "flex_gap": {
          "unit": "px",
          "size": 18,
          "column": "18",
          "row": "18",
          "isLinked": true
        },
        "padding": {
          "unit": "px",
          "top": "60",
          "right": "20",
          "bottom": "60",
          "left": "20",
          "isLinked": false
        },
        "background_background": "classic",
        "background_color": {
          "_color": "surface_muted"
        }
      },
      "elements": [
        {
          "elType": "widget",
          "widgetType": "icon-box",
          "settings": {
            "selected_icon": {
