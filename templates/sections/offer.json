{
  "nombre": "offer",
  "descripcion": "Qué incluye, módulo a módulo. Cada tarjeta cierra con el resultado concreto del módulo, no con su temario.",
  "requiere": [
    "copy.offer.headline",
    "curso.modulos"
  ],
  "nodos": [
    {
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "center",
        "flex_gap": {
          "unit": "px",
          "size": 32,
          "column": "32",
          "row": "32",
          "isLinked": true
        },
        "padding": {
          "unit": "px",
          "top": "{{marca.escala.seccionPaddingY}}",
          "right": "20",
          "bottom": "{{marca.escala.seccionPaddingY}}",
          "left": "20",
          "isLinked": false
        },
        "background_background": "classic",
        "background_color": {
          "_color": "surface_light"
        }
      },
      "elements": [
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.offer.headline}}",
            "header_size": "h2",
            "align": "center",
            "title_color": {
              "_color": "text"
            },
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": "{{marca.escala.h2}}"
            },
            "typography_font_size_mobile": {
              "unit": "px",
              "size": 27
            },
            "typography_font_weight": "800",
            "typography_line_height": {
              "unit": "em",
              "size": 1.2
            },
            "_element_custom_width": {
              "unit": "%",
              "size": 76
            }
          },
          "elements": []
        },
        {
          "_if": "copy.offer.intro",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p style=\"text-align:center\">{{copy.offer.intro}}</p>",
            "text_color": {
              "_color": "text_muted"
            },
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 18
            },
            "typography_line_height": {
              "unit": "em",
              "size": 1.6
            },
            "_element_custom_width": {
              "unit": "%",
              "size": 68
            }
          },
          "elements": []
        },
        {
          "elType": "container",
          "isInner": true,
          "settings": {
            "content_width": "full",
            "flex_direction": "column",
            "flex_gap": {
              "unit": "px",
              "size": 16,
              "column": "16",
              "row": "16",
              "isLinked": true
            },
            "_element_custom_width": {
              "unit": "%",
              "size": 86
            }
          },
          "elements": [
            {
              "_repeat": "curso.modulos",
              "_as": "mod",
              "elType": "container",
              "isInner": true,
              "settings": {
                "content_width": "full",
                "flex_direction": "column",
                "flex_gap": {
                  "unit": "px",
                  "size": 8,
                  "column": "8",
                  "row": "8",
                  "isLinked": true
                },
                "padding": {
                  "unit": "px",
                  "top": "26",
                  "right": "28",
                  "bottom": "26",
                  "left": "28",
                  "isLinked": false
                },
                "background_background": "classic",
                "background_color": {
                  "_color": "surface_muted"
                },
                "border_radius": {
                  "unit": "px",
                  "top": "{{marca.escala.radio}}",
                  "right": "{{marca.escala.radio}}",
                  "bottom": "{{marca.escala.radio}}",
                  "left": "{{marca.escala.radio}}",
                  "isLinked": true
                }
              },
              "elements": [
                {
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "MÓDULO {{_n}}",
                    "header_size": "div",
                    "title_color": {
                      "_color": "primary"
                    },
                    "typography_typography": "custom",
                    "typography_font_size": {
                      "unit": "px",
                      "size": 12
                    },
                    "typography_font_weight": "700",
                    "typography_letter_spacing": {
                      "unit": "px",
                      "size": 1.2
                    }
                  },
                  "elements": []
                },
                {
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "{{mod.titulo}}",
                    "header_size": "h3",
                    "title_color": {
                      "_color": "text"
                    },
                    "typography_typography": "custom",
                    "typography_font_size": {
                      "unit": "px",
                      "size": 22
                    },
                    "typography_font_weight": "700"
                  },
                  "elements": []
                },
                {
                  "_if": "mod.descripcion",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p>{{mod.descripcion}}</p>",
                    "text_color": {
                      "_color": "text_muted"
                    },
                    "typography_typography": "custom",
                    "typography_font_size": {
                      "unit": "px",
                      "size": 16
                    },
                    "typography_line_height": {
                      "unit": "em",
                      "size": 1.55
                    }
                  },
                  "elements": []
                },
                {
                  "_if": "mod.resultado",
                  "elType": "widget",
                  "widgetType": "icon-list",
                  "settings": {
                    "icon_list": [
                      {
                        "text": "{{mod.resultado}}",
                        "selected_icon": {
                          "value": "fas fa-check",
                          "library": "fa-solid"
                        }
                      }
                    ],
                    "icon_color": {
                      "_color": "secondary"
                    },
                    "icon_size": {
                      "unit": "px",
                      "size": 15
                    },
                    "text_color": {
                      "_color": "text"
                    },
                    "typography_typography": "custom",
                    "typography_font_size": {
                      "unit": "px",
                      "size": 16
                    },
                    "typography_font_weight": "600"
                  },
                  "elements": []
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
