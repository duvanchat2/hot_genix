{
  "nombre": "final-cta",
  "descripcion": "Cierre: recapitula la promesa, repite el precio, repite el CTA y recuerda la garantía. Quien llega aquí ya leyó todo — solo necesita permiso para decidir.",
  "requiere": [
    "copy.final.headline",
    "copy.final.cta",
    "curso.checkout_url"
  ],
  "nodos": [
    {
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "center",
        "flex_gap": {
          "unit": "px",
          "size": 24,
          "column": "24",
          "row": "24",
          "isLinked": true
        },
        "padding": {
          "unit": "px",
          "top": "96",
          "right": "20",
          "bottom": "96",
          "left": "20",
          "isLinked": false
        },
        "background_background": "gradient",
        "background_color": {
          "_color": "secondary"
        },
        "background_color_b": {
          "_color": "primary"
        },
        "background_gradient_angle": {
          "unit": "deg",
          "size": 135
        }
      },
      "elements": [
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.final.headline}}",
            "header_size": "h2",
            "align": "center",
            "title_color": "#FFFFFF",
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 42
            },
            "typography_font_size_mobile": {
              "unit": "px",
              "size": 28
            },
            "typography_font_weight": "800",
            "typography_line_height": {
              "unit": "em",
              "size": 1.18
            },
            "_element_custom_width": {
              "unit": "%",
              "size": 74
            }
          },
          "elements": []
        },
        {
          "_if": "copy.final.subhead",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p style=\"text-align:center\">{{copy.final.subhead}}</p>",
            "text_color": "#F0EDFF",
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 19
            },
            "typography_line_height": {
              "unit": "em",
              "size": 1.55
            },
            "_element_custom_width": {
              "unit": "%",
              "size": 64
            }
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "button",
          "settings": {
            "text": "{{copy.final.cta}}",
            "link": {
              "url": "{{curso.checkout_url}}",
              "is_external": "on",
              "nofollow": "",
              "custom_attributes": ""
            },
            "align": "center",
            "size": "lg",
            "background_color": "#FFFFFF",
            "button_text_color": {
              "_color": "primary"
            },
            "border_radius": {
              "unit": "px",
              "top": "{{marca.escala.radioBoton}}",
              "right": "{{marca.escala.radioBoton}}",
              "bottom": "{{marca.escala.radioBoton}}",
              "left": "{{marca.escala.radioBoton}}",
              "isLinked": true
            },
            "text_padding": {
              "unit": "px",
              "top": "22",
              "right": "48",
              "bottom": "22",
              "left": "48",
              "isLinked": false
            },
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 19
            },
            "typography_font_weight": "800"
          },
          "elements": []
        },
        {
          "_if": "copy.final.microcopy",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.final.microcopy}}",
            "header_size": "div",
            "align": "center",
            "title_color": "#E4DEFF",
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 14
            }
          },
          "elements": []
        }
      ]
    }
  ]
}
