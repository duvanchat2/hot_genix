{
  "nombre": "bonus",
  "descripcion": "Stack de bonus con valor percibido. Cierra sumando el valor total, que es el ancla para la sección de precio.",
  "requiere": [
    "curso.bonus"
  ],
  "nodos": [
    {
      "_if": "curso.bonus",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "center",
        "flex_gap": {
          "unit": "px",
          "size": 28,
          "column": "28",
          "row": "28",
          "isLinked": true
        },
        "padding": {
          "unit": "px",
          "top": "{{marca.escala.seccionPaddingY}}",
          "right": "20",
          "bottom": "{{marca.escala.seccionPaddingY}}",
          "left": "20",
          "isLinked": false
        },
        "background_background": "classic",
        "background_color": {
          "_color": "surface_muted"
        }
      },
      "elements": [
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.bonus.headline}}",
            "header_size": "h2",
            "align": "center",
            "title_color": {
              "_color": "text"
            },
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": "{{marca.escala.h2}}"
            },
            "typography_font_size_mobile": {
              "unit": "px",
              "size": 27
            },
            "typography_font_weight": "800",
            "typography_line_height": {
              "unit": "em",
              "size": 1.2
            },
            "_element_custom_width": {
              "unit": "%",
              "size": 76
            }
          },
          "elements": []
        },
        {
          "elType": "container",
          "isInner": true,
          "settings": {
            "content_width": "full",
            "flex_direction": "row",
            "flex_justify_content": "center",
            "flex_wrap": "wrap",
            "flex_gap": {
              "unit": "px",
              "size": 20,
              "column": "20",
              "row": "20",
              "isLinked": true
            }
          },
          "elements": [
            {
              "_repeat": "curso.bonus",
              "_as": "b",
              "elType": "container",
              "isInner": true,
              "settings": {
                "content_width": "full",
                "flex_direction": "column",
                "flex_gap": {
                  "unit": "px",
                  "size": 10,
                  "column": "10",
                  "row": "10",
                  "isLinked": true
                },
                "width": {
                  "unit": "px",
                  "size": 340
                },
                "padding": {
                  "unit": "px",
                  "top": "26",
                  "right": "24",
                  "bottom": "26",
                  "left": "24",
                  "isLinked": false
                },
                "background_background": "classic",
                "background_color": {
                  "_color": "surface_light"
                },
                "border_radius": {
                  "unit": "px",
                  "top": "{{marca.escala.radio}}",
                  "right": "{{marca.escala.radio}}",
                  "bottom": "{{marca.escala.radio}}",
                  "left": "{{marca.escala.radio}}",
                  "isLinked": true
                },
                "border_border": "solid",
                "border_width": {
                  "unit": "px",
                  "top": "2",
                  "right": "2",
                  "bottom": "2",
                  "left": "2",
                  "isLinked": true
                },
                "border_color": {
                  "_color": "secondary"
                }
              },
              "elements": [
                {
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "BONUS {{_n}}",
                    "header_size": "div",
                    "title_color": {
                      "_color": "secondary"
                    },
                    "typography_typography": "custom",
                    "typography_font_size": {
                      "unit": "px",
                      "size": 12
                    },
                    "typography_font_weight": "700",
                    "typography_letter_spacing": {
                      "unit": "px",
                      "size": 1.2
                    }
                  },
                  "elements": []
                },
                {
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "{{b.nombre}}",
                    "header_size": "h3",
                    "title_color": {
                      "_color": "text"
                    },
                    "typography_typography": "custom",
                    "typography_font_size": {
                      "unit": "px",
                      "size": 21
                    },
                    "typography_font_weight": "700"
                  },
                  "elements": []
                },
                {
                  "_if": "b.descripcion",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p>{{b.descripcion}}</p>",
                    "text_color": {
                      "_color": "text_muted"
                    },
                    "typography_typography": "custom",
                    "typography_font_size": {
                      "unit": "px",
                      "size": 16
                    },
                    "typography_line_height": {
                      "unit": "em",
                      "size": 1.55
                    }
                  },
                  "elements": []
                },
                {
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "title": "Valor: {{d.simbolo}}{{b.valor | money}}",
                    "header_size": "div",
                    "title_color": {
                      "_color": "accent"
                    },
                    "typography_typography": "custom",
                    "typography_font_size": {
                      "unit": "px",
                      "size": 16
                    },
                    "typography_font_weight": "700"
                  },
                  "elements": []
                }
              ]
            }
          ]
        },
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Valor total de los bonus: {{d.simbolo}}{{d.valor_bonus | money}}",
            "header_size": "h3",
            "align": "center",
            "title_color": {
              "_color": "text"
            },
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": 24
            },
            "typography_font_weight": "800"
          },
          "elements": []
        }
      ]
    }
  ]
}
