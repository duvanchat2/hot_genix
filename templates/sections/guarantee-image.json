{
  "nombre": "guarantee-image",
  "descripcion": "Variante de 'guarantee' con la imagen de sellos de garantía en vez del ícono de escudo.",
  "requiere": ["curso.garantia.dias", "assets.sellos-garantia"],
  "nodos": [
    {
      "_if": "curso.garantia.dias",
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "center",
        "flex_gap": { "unit": "px", "size": 20, "column": "20", "row": "20", "isLinked": true },
        "padding": { "unit": "px", "top": "64", "right": "20", "bottom": "64", "left": "20", "isLinked": false },
        "background_background": "classic",
        "background_color": { "_color": "surface_muted" }
      },
      "elements": [
        {
          "elType": "widget",
          "widgetType": "image",
          "settings": {
            "_if": "assets.sellos-garantia",
            "image": { "url": "{{assets.sellos-garantia}}", "source": "url", "alt": "Garantía de {{curso.garantia.dias}} días" },
            "image_size": "full",
            "width": { "unit": "%", "size": 100 },
            "_element_custom_width": { "unit": "%", "size": 52 }
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Garantía de {{curso.garantia.dias}} días",
            "header_size": "h3",
            "align": "center",
            "title_color": { "_color": "text" },
            "typography_typography": "custom",
            "typography_font_size": { "unit": "px", "size": 26 },
            "typography_font_weight": "800"
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p style=\"text-align:center\">{{copy.guarantee.texto}}</p>",
            "text_color": { "_color": "text_muted" },
            "typography_typography": "custom",
            "typography_font_size": { "unit": "px", "size": 17 },
            "typography_line_height": { "unit": "em", "size": 1.6 },
            "_element_custom_width": { "unit": "%", "size": 62 }
          },
          "elements": []
        }
      ]
    }
  ]
}
