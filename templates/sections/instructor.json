{
  "nombre": "instructor",
  "descripcion": "Quién enseña y por qué creerle. Foto a la izquierda, credenciales a la derecha. Status antes que currículum.",
  "requiere": [
    "curso.instructor.nombre",
    "curso.instructor.bio"
  ],
  "nodos": [
    {
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "row",
        "flex_align_items": "center",
        "flex_justify_content": "center",
        "flex_wrap": "wrap",
        "flex_gap": {
          "unit": "px",
          "size": 44,
          "column": "44",
          "row": "44",
          "isLinked": true
        },
        "padding": {
          "unit": "px",
          "top": "{{marca.escala.seccionPaddingY}}",
          "right": "20",
          "bottom": "{{marca.escala.seccionPaddingY}}",
          "left": "20",
          "isLinked": false
        },
        "background_background": "classic",
        "background_color": {
          "_color": "surface_dark"
        }
      },
      "elements": [
        {
          "_if": "curso.instructor.foto",
          "elType": "container",
          "isInner": true,
          "settings": {
            "content_width": "full",
            "width": {
              "unit": "px",
              "size": 300
            },
            "flex_direction": "column"
          },
          "elements": [
            {
              "elType": "widget",
              "widgetType": "image",
              "settings": {
                "image": {
                  "url": "{{curso.instructor.foto}}",
                  "source": "url",
                  "alt": "{{curso.instructor.nombre}}"
                },
                "image_size": "full",
                "align": "center",
                "border_radius": {
                  "unit": "px",
                  "top": "20",
                  "right": "20",
                  "bottom": "20",
                  "left": "20",
                  "isLinked": true
                }
              },
              "elements": []
            }
          ]
        },
        {
          "elType": "container",
          "isInner": true,
          "settings": {
            "content_width": "full",
            "width": {
              "unit": "px",
              "size": 560
            },
            "flex_direction": "column",
            "flex_gap": {
              "unit": "px",
              "size": 16,
              "column": "16",
              "row": "16",
              "isLinked": true
            }
          },
          "elements": [
            {
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "{{copy.instructor.headline}}",
                "header_size": "h2",
                "title_color": {
                  "_color": "text_on_dark"
                },
                "typography_typography": "custom",
                "typography_font_size": {
                  "unit": "px",
                  "size": 34
                },
                "typography_font_weight": "800",
                "typography_line_height": {
                  "unit": "em",
                  "size": 1.2
                }
              },
              "elements": []
            },
            {
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p>{{copy.instructor.bio}}</p>",
                "text_color": {
                  "_color": "text_muted"
                },
                "typography_typography": "custom",
                "typography_font_size": {
                  "unit": "px",
                  "size": 17
                },
                "typography_line_height": {
                  "unit": "em",
                  "size": 1.65
                }
              },
              "elements": []
            },
            {
              "_if": "curso.instructor.credenciales",
              "elType": "widget",
              "widgetType": "icon-list",
              "settings": {
                "icon_list": {
                  "_as": "c",
                  "_map": "curso.instructor.credenciales",
                  "_template": {
                    "text": "{{c}}",
                    "selected_icon": {
                      "value": "fas fa-check",
                      "library": "fa-solid"
                    }
                  }
                },
                "space_between": {
                  "unit": "px",
                  "size": 12
                },
                "icon_color": {
                  "_color": "secondary"
                },
                "icon_size": {
                  "unit": "px",
                  "size": 15
                },
                "text_color": {
                  "_color": "text_on_dark"
                },
                "typography_typography": "custom",
                "typography_font_size": {
                  "unit": "px",
                  "size": 16
                }
              },
              "elements": []
            }
          ]
        }
      ]
    }
  ]
}
