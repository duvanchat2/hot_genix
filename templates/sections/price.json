{
  "nombre": "price",
  "descripcion": "Stack de valor, ancla tachada, precio real y CTA. El trabajo aquí no es justificar el precio: es que no comprar parezca la decisión cara.",
  "requiere": [
    "copy.price.headline",
    "copy.price.cta",
    "curso.precio",
    "curso.checkout_url"
  ],
  "nodos": [
    {
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "column",
        "flex_align_items": "center",
        "flex_gap": {
          "unit": "px",
          "size": 26,
          "column": "26",
          "row": "26",
          "isLinked": true
        },
        "padding": {
          "unit": "px",
          "top": "{{marca.escala.seccionPaddingY}}",
          "right": "20",
          "bottom": "{{marca.escala.seccionPaddingY}}",
          "left": "20",
          "isLinked": false
        },
        "background_background": "classic",
        "background_color": {
          "_color": "surface_dark"
        }
      },
      "elements": [
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.price.headline}}",
            "header_size": "h2",
            "align": "center",
            "title_color": {
              "_color": "text_on_dark"
            },
            "typography_typography": "custom",
            "typography_font_size": {
              "unit": "px",
              "size": "{{marca.escala.h2}}"
            },
            "typography_font_size_mobile": {
              "unit": "px",
              "size": 27
            },
            "typography_font_weight": "800",
            "typography_line_height": {
              "unit": "em",
              "size": 1.2
            },
            "_element_custom_width": {
              "unit": "%",
              "size": 76
            }
          },
          "elements": []
        },
        {
          "elType": "container",
          "isInner": true,
          "settings": {
            "content_width": "full",
            "flex_direction": "column",
            "flex_gap": {
              "unit": "px",
              "size": 20,
              "column": "20",
              "row": "20",
              "isLinked": true
            },
            "width": {
              "unit": "px",
              "size": 620
            },
            "padding": {
              "unit": "px",
              "top": "40",
              "right": "36",
              "bottom": "40",
              "left": "36",
              "isLinked": false
            },
            "background_background": "classic",
            "background_color": {
              "_color": "surface_light"
            },
            "border_radius": {
              "unit": "px",
              "top": "20",
              "right": "20",
              "bottom": "20",
              "left": "20",
              "isLinked": true
            }
          },
          "elements": [
            {
              "_if": "d.stack_valor",
              "elType": "widget",
              "widgetType": "icon-list",
              "settings": {
                "icon_list": {
                  "_as": "linea",
                  "_map": "d.stack_valor",
                  "_template": {
                    "text": "{{linea.concepto}} — <strong>{{d.simbolo}}{{linea.valor | money}}</strong>",
                    "selected_icon": {
                      "value": "fas fa-check",
                      "library": "fa-solid"
                    }
                  }
                },
                "space_between": {
                  "unit": "px",
                  "size": 13
                },
                "icon_color": {
                  "_color": "secondary"
                },
                "icon_size": {
                  "unit": "px",
                  "size": 15
                },
                "text_color": {
                  "_color": "text"
                },
                "typography_typography": "custom",
                "typography_font_size": {
                  "unit": "px",
                  "size": 17
                }
              },
              "elements": []
            },
            {
              "elType": "widget",
              "widgetType": "divider",
              "settings": {
                "style": "solid",
                "weight": {
                  "unit": "px",
                  "size": 1
                },
                "color": "#E3E5EC",
                "gap": {
                  "unit": "px",
                  "size": 6
                }
              },
              "elements": []
            },
            {
              "_if": "d.precio_ancla",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Valor real: {{d.simbolo}}{{d.valor_total | money}}",
                "header_size": "div",
                "align": "center",
                "title_color": {
                  "_color": "text_muted"
                },
                "typography_typography": "custom",
                "typography_font_size": {
                  "unit": "px",
                  "size": 19
                },
                "typography_font_weight": "600",
                "typography_text_decoration": "line-through"
              },
              "elements": []
            },
            {
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "{{d.simbolo}}{{d.precio | money}} {{d.moneda}}",
                "header_size": "div",
                "align": "center",
                "title_color": {
                  "_color": "text"
                },
                "typography_typography": "custom",
                "typography_font_size": {
                  "unit": "px",
                  "size": 62
                },
                "typography_font_size_mobile": {
                  "unit": "px",
                  "size": 46
                },
                "typography_font_weight": "800",
                "typography_line_height": {
                  "unit": "em",
                  "size": 1
                }
              },
              "elements": []
            },
            {
              "_if": "curso.pago.nota",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "{{curso.pago.nota}}",
                "header_size": "div",
                "align": "center",
                "title_color": {
                  "_color": "text_muted"
                },
                "typography_typography": "custom",
                "typography_font_size": {
                  "unit": "px",
                  "size": 15
                }
              },
              "elements": []
            },
            {
              "elType": "widget",
              "widgetType": "button",
              "settings": {
                "text": "{{copy.price.cta}}",
                "link": {
                  "url": "{{curso.checkout_url}}",
                  "is_external": "on",
                  "nofollow": "",
                  "custom_attributes": ""
                },
                "align": "justify",
                "size": "lg",
                "background_color": {
                  "_color": "primary"
                },
                "button_text_color": "#FFFFFF",
                "border_radius": {
                  "unit": "px",
                  "top": "{{marca.escala.radioBoton}}",
                  "right": "{{marca.escala.radioBoton}}",
                  "bottom": "{{marca.escala.radioBoton}}",
                  "left": "{{marca.escala.radioBoton}}",
                  "isLinked": true
                },
                "text_padding": {
                  "unit": "px",
                  "top": "22",
                  "right": "40",
                  "bottom": "22",
                  "left": "40",
                  "isLinked": false
                },
                "typography_typography": "custom",
                "typography_font_size": {
                  "unit": "px",
                  "size": 19
                },
                "typography_font_weight": "700"
              },
              "elements": []
            },
            {
              "_if": "copy.price.urgencia",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "{{copy.price.urgencia}}",
                "header_size": "div",
                "align": "center",
                "title_color": {
                  "_color": "accent"
                },
                "typography_typography": "custom",
                "typography_font_size": {
                  "unit": "px",
                  "size": 15
                },
                "typography_font_weight": "700"
              },
              "elements": []
            }
          ]
        }
      ]
    }
  ]
}
