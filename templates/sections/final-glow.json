{
  "nombre": "final-glow",
  "descripcion": "CTA final sobre fondo oscuro con brillo de los dos colores de marca detrás: titular, subtítulo, botón degradado y microcopy.",
  "requiere": [
    "copy.final.headline",
    "copy.final.cta",
    "curso.checkout_url"
  ],
  "nodos": [
    {
      "elType": "container",
      "isInner": false,
      "settings": {
        "content_width": "boxed",
        "flex_direction": "column",
        "padding": {
          "unit": "px",
          "top": "120",
          "right": "20",
          "bottom": "120",
          "left": "20",
          "isLinked": false
        },
        "padding_mobile": {
          "unit": "px",
          "top": "80",
          "right": "16",
          "bottom": "80",
          "left": "16",
          "isLinked": false
        },
        "background_background": "classic",
        "background_color": {
          "_color": "surface_dark"
        },
        "flex_align_items": "center",
        "flex_gap": {
          "unit": "px",
          "size": 22,
          "column": "22",
          "row": "22",
          "isLinked": true
        },
        "boxed_width": {
          "unit": "px",
          "size": 820
        },
        "css_classes": "gx-glow-center",
        "overflow": "hidden"
      },
      "elements": [
        {
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.final.headline}}",
            "header_size": "h2",
            "align": "center",
            "title_color": {
              "_color": "text_on_dark"
            },
            "typography_typography": "custom",
            "typography_font_family": {
              "_font": "heading"
            },
            "typography_font_size": {
              "unit": "px",
              "size": 46
            },
            "typography_font_size_mobile": {
              "unit": "px",
              "size": 28
            },
            "typography_font_weight": "800",
            "typography_line_height": {
              "unit": "em",
              "size": 1.12
            },
            "typography_letter_spacing": {
              "unit": "px",
              "size": -0.9
            }
          },
          "elements": []
        },
        {
          "_if": "copy.final.subhead",
          "elType": "widget",
          "widgetType": "text-editor",
          "settings": {
            "editor": "<p style=\"text-align:center\">{{copy.final.subhead}}</p>",
            "text_color": {
              "_color": "text_on_dark_muted"
            },
            "typography_typography": "custom",
            "typography_font_family": {
              "_font": "body"
            },
            "typography_font_size": {
              "unit": "px",
              "size": 19
            },
            "typography_font_size_mobile": {
              "unit": "px",
              "size": 16
            },
            "typography_line_height": {
              "unit": "em",
              "size": 1.6
            }
          },
          "elements": []
        },
        {
          "elType": "widget",
          "widgetType": "button",
          "settings": {
            "text": "{{copy.final.cta}}",
            "link": {
              "url": "{{curso.checkout_url}}",
              "is_external": "",
              "nofollow": "",
              "custom_attributes": ""
            },
            "align": "center",
            "align_mobile": "justify",
            "size": "lg",
            "background_background": "gradient",
            "background_color": {
              "_color": "primary"
            },
            "background_color_b": {
              "_color": "secondary"
            },
            "background_gradient_angle": {
              "unit": "deg",
              "size": 135
            },
            "button_text_color": "#FFFFFF",
            "border_radius": {
              "unit": "px",
              "top": "12",
              "right": "12",
              "bottom": "12",
              "left": "12",
              "isLinked": true
            },
            "text_padding": {
              "unit": "px",
              "top": "20",
              "right": "40",
              "bottom": "20",
              "left": "40",
              "isLinked": false
            },
            "typography_typography": "custom",
            "typography_font_family": {
              "_font": "body"
            },
            "typography_font_size": {
              "unit": "px",
              "size": 19
            },
            "typography_font_weight": "800",
            "_css_classes": "gx-btn"
          },
          "elements": []
        },
        {
          "_if": "copy.final.microcopy",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "{{copy.final.microcopy}}",
            "header_size": "div",
            "align": "center",
            "title_color": {
              "_color": "text_on_dark_muted"
            },
            "typography_typography": "custom",
            "typography_font_family": {
              "_font": "body"
            },
            "typography_font_size": {
              "unit": "px",
              "size": 14
            }
          },
          "elements": []
        }
      ]
    }
  ]
}
