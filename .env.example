# Copia este archivo a .env y rellena los valores. .env está en .gitignore.
# NUNCA commitees claves reales.

# --- kie.ai (generación de imágenes) ---
# Alternativa recomendada: guardar la clave en ~/.config/kieai/api-key con chmod 600
KIEAI_API_KEY=
KIEAI_API_BASE=https://api.kie.ai/api/v1

# --- WordPress destino (landings con Elementor) ---
# Solo necesario para la publicación automática (Fase 4). El import manual no lo usa.
WP_BASE_URL=https://tu-dominio-nuevo.com
WP_USER=
WP_APP_PASSWORD=
